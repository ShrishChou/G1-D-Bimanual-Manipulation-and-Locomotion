# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# large / generated artifacts -- never commit weights, datasets, or logs
*.pt
*.pth
*.safetensors
checkpoints/
datasets/
*.parquet
*.log
*.csv

# media: ignore everything EXCEPT the curated demo videos in docs/videos
*.mp4
*.png
*.jpg
!docs/videos/*.mp4
!docs/videos/*.gif
!docs/videos/*.png

# fetched robot model (public Unitree G1, pulled by scripts/fetch_g1_assets.py)
assets/g1/
# procedurally generated scene meshes
sim/assets/
